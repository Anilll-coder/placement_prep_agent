# ---------------------------------------------------------------
# LLM - pick ONE provider and paste its key
# ---------------------------------------------------------------
# groq (free tier, very fast) | openai | gemini | openrouter | ollama (local, no key)
LLM_PROVIDER=groq
# Leave empty for the lightweight default:
#   groq -> llama-3.1-8b-instant   openai -> gpt-4o-mini
#   gemini -> gemini-2.5-flash     openrouter -> meta-llama/llama-3.1-8b-instruct
#   ollama -> llama3.2
LLM_MODEL=

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Only for LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------
# Web search
# ---------------------------------------------------------------
# duckduckgo (no key) | tavily | perplexity | searxng | none
SEARCH_API=duckduckgo
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
SEARXNG_URL=http://localhost:8888

# ---------------------------------------------------------------
# Agent tuning
# ---------------------------------------------------------------
MAX_RESEARCH_LOOPS=2
QUERIES_PER_ROUND=3
FETCH_FULL_PAGE=False
NUM_PRACTICE_QUESTIONS=15
